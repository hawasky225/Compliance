generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { PLATFORM_ADMIN PROFESSIONAL TRAINER ASSESSOR EMPLOYER_ADMIN VERIFIER }
enum EnrollmentStatus { ENROLLED IN_PROGRESS COMPLETED FAILED }
enum CertificationStatus { PENDING ACTIVE EXPIRING EXPIRED SUSPENDED REVOKED }
enum AssessmentType { QUIZ EXAM CASE_STUDY PRACTICAL }
enum AttemptStatus { IN_PROGRESS SUBMITTED GRADED }
enum QuestionType { SINGLE_CHOICE MULTIPLE_CHOICE TRUE_FALSE }

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role UserRole @default(PROFESSIONAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  professional Professional?
}

model Professional {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  professionalId String @unique
  jobTitle String?
  employer String?
  sector String @default("MINING")
  country String?
  city String?
  phone String?
  identityVerified Boolean @default(false)
  onboardingCompleted Boolean @default(false)
  enrollments Enrollment[]
  certifications Certification[]
  results AssessmentResult[]
  attempts ExamAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String?
  durationMinutes Int
  level String
  published Boolean @default(false)
  enrollments Enrollment[]
  assessments Assessment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id String @id @default(cuid())
  professionalId String
  professional Professional @relation(fields:[professionalId], references:[id], onDelete:Cascade)
  courseId String
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  status EnrollmentStatus @default(ENROLLED)
  progress Int @default(0)
  startedAt DateTime @default(now())
  completedAt DateTime?
  @@unique([professionalId,courseId])
}

model Assessment {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields:[courseId], references:[id], onDelete:Cascade)
  schemeId String?
  scheme CertificationScheme? @relation(fields:[schemeId], references:[id])
  title String
  type AssessmentType
  passingScore Int @default(75)
  maxAttempts Int @default(2)
  durationMinutes Int @default(45)
  published Boolean @default(false)
  questions Question[]
  results AssessmentResult[]
  attempts ExamAttempt[]
}

model Question {
  id String @id @default(cuid())
  assessmentId String
  assessment Assessment @relation(fields:[assessmentId], references:[id], onDelete:Cascade)
  prompt String
  type QuestionType @default(SINGLE_CHOICE)
  options Json
  correctAnswers Json
  points Int @default(1)
  sortOrder Int @default(0)
  answers ExamAnswer[]
  @@index([assessmentId,sortOrder])
}

model ExamAttempt {
  id String @id @default(cuid())
  assessmentId String
  assessment Assessment @relation(fields:[assessmentId], references:[id], onDelete:Cascade)
  professionalId String
  professional Professional @relation(fields:[professionalId], references:[id], onDelete:Cascade)
  attemptNumber Int
  status AttemptStatus @default(IN_PROGRESS)
  score Int?
  passed Boolean?
  startedAt DateTime @default(now())
  submittedAt DateTime?
  answers ExamAnswer[]
  @@unique([assessmentId,professionalId,attemptNumber])
  @@index([professionalId,status])
}

model ExamAnswer {
  id String @id @default(cuid())
  attemptId String
  attempt ExamAttempt @relation(fields:[attemptId], references:[id], onDelete:Cascade)
  questionId String
  question Question @relation(fields:[questionId], references:[id], onDelete:Cascade)
  selectedAnswers Json
  correct Boolean
  pointsAwarded Int @default(0)
  @@unique([attemptId,questionId])
}

model AssessmentResult {
  id String @id @default(cuid())
  assessmentId String
  assessment Assessment @relation(fields:[assessmentId], references:[id], onDelete:Cascade)
  professionalId String
  professional Professional @relation(fields:[professionalId], references:[id], onDelete:Cascade)
  score Int
  passed Boolean
  attempt Int
  completedAt DateTime @default(now())
}

model CertificationScheme {
  id String @id @default(cuid())
  code String @unique
  title String
  description String?
  validityMonths Int @default(36)
  passingScore Int @default(75)
  maxAttempts Int @default(2)
  requiresPractical Boolean @default(false)
  active Boolean @default(true)
  assessments Assessment[]
  certifications Certification[]
}

model Certification {
  id String @id @default(cuid())
  certificateNumber String @unique
  schemeId String
  scheme CertificationScheme @relation(fields:[schemeId], references:[id])
  professionalId String
  professional Professional @relation(fields:[professionalId], references:[id], onDelete:Cascade)
  status CertificationStatus @default(PENDING)
  issuedAt DateTime?
  expiresAt DateTime?
  verificationToken String @unique @default(cuid())
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([professionalId,status])
  @@index([expiresAt,status])
  @@unique([schemeId,professionalId,issuedAt])
}
